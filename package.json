{
  "name": "kadr",
  "version": "0.8.2",
  "description": "Kadr — GPU-accelerated multi-track video editor with AI integration",
  "main": "out/main/main.js",
  "author": "Black Triangle",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:ui:dev": "node scripts/tauri/prepare.mjs && vite --config vite.tauri.config.ts",
    "tauri:ui:build": "node scripts/tauri/prepare.mjs && vite build --config vite.tauri.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "node scripts/rebuild-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "mp4-muxer": "^5.1.5",
    "mp4box": "^2.3.0",
    "node-pty": "^1.1.0",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.1"
  },
  "contributors": [
    "Black Triangle",
    "Codex (OpenAI)"
  ]
}
